# Origin of sm85-arch WITHOUT /api. Used by server components (SSR) and the /api rewrite.
BACKEND_URL=http://localhost:8000
# Browser-side origin of sm85-arch (build time), e.g. https://api.ampelkuning.com.
# Leave EMPTY to call this app's own origin; /api is then proxied to BACKEND_URL (cookie stays first-party).
NEXT_PUBLIC_BACKEND_URL=
# Public site origin, used for canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth Web Client ID for "Masuk dengan Google". Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
