FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable
COPY . .
ARG BACKEND_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV BACKEND_URL=$BACKEND_URL NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID NEXT_TELEMETRY_DISABLED=1
RUN pnpm install --frozen-lockfile && pnpm --filter @store/buyer build
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
CMD ["sh","-c","cd apps/store-buyer && ./node_modules/.bin/next start -p 8080"]
